/** Stock42 Santé V3.3 — inventaire partagé, classeur Santé uniquement.
 * Clé privée dans SANTE_API_TOKEN, jamais dans le code ni dans les URL.
 * Déployer en application Web, exécuter en tant que propriétaire.
 */
const SANTE_SHEETS=Object.freeze({lots:'Réception & lots Santé',moves:'Mouvements Santé'});
const SANTE_DB='1kcr4LWpIyWEKYYUXglsMdENVqnHpY_qwGC3s3UFawwo';
const SANTE_LOCATIONS=Object.freeze((()=>{const out=[];for(let r=1;r<=3;r++)for(let n=1;n<=5;n++)for(const z of ['A','B','C'])out.push('42-R'+r+'-N'+n+'-'+z);for(const [prefix,total]of [['42-CONGELATEUR-',6],['42-FRIGO-',5],['42-GARAGE-',4],['38-ETAGE-',18]])for(let i=1;i<=total;i++)out.push(prefix+String(i).padStart(2,'0'));return out;})());
function location_(value){const raw=String(value||'').trim();if(!raw||/^à\s+ranger$/i.test(raw))return 'À ranger';const code=raw.toUpperCase().replace(/[ _]+/g,'-').replace(/[\u2010-\u2015]/g,'-');if(!SANTE_LOCATIONS.includes(code))throw Error('Emplacement inconnu : sélectionner ou lire un QR existant du 42 ou du 38.');return code;}
function site_(location){return location.startsWith('38-')?'Site 38':'Site 42';}
function db_(){const ss=SpreadsheetApp.openById(SANTE_DB);if(ss.getId()!==SANTE_DB||!ss.getSheetByName(SANTE_SHEETS.lots)||!ss.getSheetByName(SANTE_SHEETS.moves))throw Error('Classeur Santé introuvable.');return ss;}
function authorize_(token){const expected=PropertiesService.getScriptProperties().getProperty('SANTE_API_TOKEN');if(!expected||typeof token!=='string'||token!==expected)throw Error('Clé Santé incorrecte.');}
function initializeSanteToken(){db_();const p=PropertiesService.getScriptProperties();if(p.getProperty('SANTE_API_TOKEN'))throw Error('Clé existante : ne pas la remplacer.');p.setProperty('SANTE_API_TOKEN',(Utilities.getUuid()+Utilities.getUuid()).replace(/-/g,''));return 'Clé créée dans les propriétés privées.';}
function setupSante(){const r={ok:true,service:'Stock42-Sante',spreadsheetId:db_().getId(),configured:!!PropertiesService.getScriptProperties().getProperty('SANTE_API_TOKEN'),version:'3.3'};console.log(JSON.stringify(r));return r;}
function doGet(){return HtmlService.createHtmlOutput(SANTE_SHARED_HTML.replace('<!--QR_DECODER-->',HtmlService.createHtmlOutputFromFile('QrDecoder').getContent())).setTitle('Stock 42 — Santé partagée').addMetaTag('viewport','width=device-width,initial-scale=1');}
// Le transfert de snapshots locaux V3 est désactivé : il ne peut plus écraser les données partagées.
function doPost(){return ContentService.createTextOutput(JSON.stringify({ok:false,error:'Utiliser l’inventaire partagé Santé V3.3.'})).setMimeType(ContentService.MimeType.JSON);}
function date_(v){if(!v)return '';const d=new Date(v);if(isNaN(d.getTime()))throw Error('Date invalide.');return d.toISOString();}
function day_(v){return v?Utilities.formatDate(new Date(v),'Europe/Paris','yyyy-MM-dd'):'';}
function clean_(v,max){const s=String(v||'').trim();if(s.length>max)throw Error('Texte trop long.');return /^[=+@-]/.test(s)?"'"+s:s;}
function readRows_(sh){return sh.getDataRange().getValues().slice(1).filter(r=>r[0]!==''&&r[0]!==null);}
function state_(){
 const ss=db_(),rawLots=readRows_(ss.getSheetByName(SANTE_SHEETS.lots)),rawMoves=readRows_(ss.getSheetByName(SANTE_SHEETS.moves));
 const ids=new Set(),uids=new Set();
 const events=rawMoves.map(r=>{const uid=String(r[10]||'');if(!uid||uids.has(uid))throw Error('Journal à vérifier : référence manquante ou dupliquée.');uids.add(uid);let meta={};try{meta=JSON.parse(String(r[8]||''))}catch(e){}return {date:date_(r[0]),id:String(r[1]),type:String(r[3]),quantity:Number(r[4]),impact:Number(r[12]),uid,note:String(r[8]||''),reversesUid:meta.reversesUid||'',signature:meta.signature||'',source:String(r[6]||''),destination:String(r[7]||'')};});
 const lots=rawLots.map(r=>{const id=String(r[0]);if(ids.has(id)||!/^S\d{4,}$/.test(id))throw Error('Lots à vérifier : identifiant invalide ou dupliqué.');ids.add(id);const received=Number(r[4]);if(!Number.isSafeInteger(received)||received<0)throw Error('Quantité reçue invalide.');const quantity=received+events.filter(e=>e.id===id).reduce((n,e)=>n+e.impact,0);if(!Number.isSafeInteger(quantity)||quantity<0||events.some(e=>!Number.isSafeInteger(e.impact)||!Number.isSafeInteger(e.quantity)))throw Error('Stock ou journal incohérent.');return {id,name:String(r[2]),size:String(r[2]).match(/—\s*([LM])\s*$/)?.[1]||'',received:date_(r[1]),receivedQuantity:received,quantity,unit:String(r[5]),expiry:day_(r[6]),manufacturer:String(r[14]||''),barcode:String(r[15]||''),location:String(r[11]||'À ranger'),site:String(r[10]||'Site 42'),status:String(r[12]||'À ranger')};});
 if(events.some(e=>!ids.has(e.id)))throw Error('Mouvement sans lot : vérification nécessaire.');
 // Les anciennes annulations V2 ont un mouvement reconstitué explicitement identifié.
 events.filter(e=>e.type==='Retour / annulation de sortie'&&!e.reversesUid).forEach(e=>{if(uids.has('legacy_exit_'+e.uid))e.reversesUid='legacy_exit_'+e.uid;});
 const serialized=JSON.stringify({lots,events});const revision=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,serialized).map(b=>(b&255).toString(16).padStart(2,'0')).join('');
 return {ok:true,lots,events,locations:SANTE_LOCATIONS.slice(),revision,updatedAt:new Date().toISOString(),version:'3.3'};
}
function santeLire(token){authorize_(token);const lock=LockService.getScriptLock();lock.waitLock(25000);try{recoverSante_();return state_();}finally{lock.releaseLock();}}
function santeAgir(token,command){
 authorize_(token);const lock=LockService.getScriptLock();lock.waitLock(25000);
 try{
  if(!command||typeof command!=='object'||JSON.stringify(command).length>4000||!/^[a-f0-9]{32}$/.test(command.uid||''))throw Error('Commande invalide.');
  const action=command.action;if(!['sortie','retour','entree','rangement'].includes(action))throw Error('Action invalide.');
  const signature=JSON.stringify([action,command.id||'',command.quantity||0,command.reversesUid||'',command.size||'',command.expiry||'',command.manufacturer||'',command.location||'',command.barcode||'']);
  recoverSante_();const before=state_(),existing=before.events.find(e=>e.uid===command.uid);
  if(existing){if(existing.signature!==signature)throw Error('Référence déjà utilisée pour une autre opération.');return before;}
  if(command.revision!==before.revision)throw Error('Le stock a changé sur un autre appareil. Actualise puis recommence.');
  const ss=db_(),sh=ss.getSheetByName(SANTE_SHEETS.lots),mh=ss.getSheetByName(SANTE_SHEETS.moves),now=new Date();
  let id=String(command.id||''),type,quantity,impact,reversesUid='',newRow=null,locationUpdate=null,source='',destination='';
  if(action==='entree'){
   quantity=Number(command.quantity);if(!['L','M'].includes(command.size)||!Number.isSafeInteger(quantity)||quantity<100||quantity>1000000||quantity%100!==0)throw Error('Réception : nombre entier de boîtes de 100 requis.');
   const expiry=String(command.expiry||'');if(!/^\d{4}-\d{2}-\d{2}$/.test(expiry)||isNaN(new Date(expiry).getTime())||day_(expiry)!==expiry||expiry<day_(now))throw Error('Péremption invalide ou dépassée.');
   id='S'+String(1+before.lots.reduce((n,l)=>Math.max(n,Number(l.id.slice(1))),0)).padStart(4,'0');
   const name=command.size==='L'?'Gants nitrile robemed+ Ultra Sensitive — L':'Gants nitrile robemedical+ Ultra Protect — M';
   const location=location_(command.location);destination=location;
   newRow=[id,now,name,'Protection / EPI',quantity,'gant',new Date(expiry),'Péremption','','',site_(location),location,location==='À ranger'?'À ranger':'Rangé','Boîte de 100',clean_(command.manufacturer,80),clean_(command.barcode,80),'Santé partagée V3.3 — réception '+command.uid];
   type='Entrée';impact=0;
  }else{
   const lot=before.lots.find(l=>l.id===id);if(!lot)throw Error('Lot introuvable.');
   source=lot.location;
   if(action==='rangement'){
    destination=location_(command.location);if(destination===lot.location)throw Error('Ce lot est déjà à cet emplacement.');
    const rows=sh.getDataRange().getValues();const index=rows.findIndex(r=>String(r[0])===id)+1;if(index<2)throw Error('Ligne du lot introuvable.');
    locationUpdate={row:index,id,fromLocation:lot.location,toLocation:destination,fromSite:lot.site,toSite:destination==='À ranger'?lot.site:site_(destination),fromStatus:lot.status,toStatus:destination==='À ranger'?'À ranger':'Rangé'};
    type='Transfert';quantity=lot.quantity;impact=0;
   }else if(action==='sortie'){
    quantity=Number(command.quantity);if(!Number.isSafeInteger(quantity)||quantity<1||quantity>lot.quantity)throw Error('Quantité indisponible.');
    if(lot.expiry&&lot.expiry<day_(now))throw Error('Lot périmé : sortie bloquée.');
    type='Sortie';impact=-quantity;
   }else{
    const source=before.events.find(e=>e.uid===command.reversesUid&&e.id===id&&e.type==='Sortie');
    if(!source||before.events.some(e=>e.reversesUid===source.uid))throw Error('Sortie introuvable ou déjà annulée.');
    quantity=source.quantity;destination=lot.location;type='Retour / annulation de sortie';impact=quantity;reversesUid=source.uid;
   }
  }
  const move=[now,id,'Gants nitrile',type,quantity,'gant',source,destination,JSON.stringify({signature,reversesUid}),'Stock42 Santé partagée',command.uid,now,impact];
  // Journal préalable : reprise idempotente si l'exécution est interrompue entre deux écritures.
  PropertiesService.getScriptProperties().setProperty('SANTE_PENDING',JSON.stringify({uid:command.uid,signature,lotRow:newRow,lotIndex:sh.getLastRow()+1,locationUpdate,move}));
  recoverSante_();
  SpreadsheetApp.flush();const after=state_();const saved=after.events.find(e=>e.uid===command.uid);if(!saved||saved.signature!==signature)throw Error('Confirmation indisponible : actualiser avant toute nouvelle opération.');return after;
 }finally{lock.releaseLock();}
}

function recoverSante_(){
 const props=PropertiesService.getScriptProperties(),raw=props.getProperty('SANTE_PENDING');if(!raw)return;
 const p=JSON.parse(raw),ss=db_(),sh=ss.getSheetByName(SANTE_SHEETS.lots),mh=ss.getSheetByName(SANTE_SHEETS.moves);
 if(p.lotRow){
  const current=sh.getRange(p.lotIndex,1,1,17).getValues()[0];
  if(current[0]&&!(current[0]===p.lotRow[0]&&String(current[16]).endsWith(p.uid)))throw Error('Réception en attente : vérifier la ligne avant reprise.');
  p.lotRow[1]=new Date(p.lotRow[1]);p.lotRow[6]=new Date(p.lotRow[6]);
  sh.getRange(p.lotIndex,1,1,17).setValues([p.lotRow]);sh.getRange(p.lotIndex,2).setNumberFormat('dd/mm/yyyy');sh.getRange(p.lotIndex,7).setNumberFormat('dd/mm/yyyy');
 }
 if(p.locationUpdate){
  const u=p.locationUpdate,row=sh.getRange(u.row,1,1,17).getValues()[0];
  const original=String(row[11])===u.fromLocation&&String(row[10])===u.fromSite&&String(row[12])===u.fromStatus;
  const applied=String(row[11])===u.toLocation&&String(row[10])===u.toSite&&String(row[12])===u.toStatus;
  if(String(row[0])!==u.id||(!original&&!applied))throw Error('Rangement en attente : ligne du lot modifiée, vérifier avant reprise.');
  sh.getRange(u.row,11,1,3).setValues([[u.toSite,u.toLocation,u.toStatus]]);
 }
 const matches=readRows_(mh).filter(r=>String(r[10])===p.uid);
 if(matches.length>1)throw Error('Mouvement en attente dupliqué.');
 if(matches.length===1&&String(matches[0][8])!==p.move[8])throw Error('Conflit de référence dans le journal.');
 if(matches.length===0){p.move[0]=new Date(p.move[0]);p.move[11]=new Date(p.move[11]);mh.appendRow(p.move);}
 SpreadsheetApp.flush();const saved=state_();if(!saved.events.some(e=>e.uid===p.uid&&e.signature===p.signature))throw Error('Écriture en attente non confirmée.');
 props.deleteProperty('SANTE_PENDING');
}

const SANTE_SHARED_HTML = "<!doctype html><html lang=\"fr\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><style>\n:root{font-family:system-ui,sans-serif;color:#17323e;background:#f2f6f7}*{box-sizing:border-box}body{max-width:920px;margin:auto;padding:18px}h1{font-size:1.65rem}h2{font-size:1.15rem}section,article{background:white;border:1px solid #d8e4e8;border-radius:16px;padding:20px;margin:16px 0}.remember{display:flex;align-items:center;gap:10px;font-weight:500}.remember input{width:auto;flex:0 0 auto}label{display:block;font-weight:600;margin:12px 0 5px}input,select,button{font:inherit;padding:12px;border-radius:9px;border:1px solid #b4c9d0;width:100%}button{background:#12647c;color:white;font-weight:650;border:0;margin:12px 0;cursor:pointer}button.secondary{background:#e8f0f4;color:#17485a}button:disabled{opacity:.5;cursor:wait}.tag{font-size:.8rem;font-weight:650;color:#12647c}.muted,small{color:#54707d}#status{padding:12px;background:#e6f0f3;border-radius:10px}#status.error{background:#fff0e9;color:#8f321a}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.lot-top{display:flex;justify-content:space-between;gap:16px}.quantity{font-size:1.6rem;font-weight:700}.expired{border-color:#c26342}.pill{display:inline-block;background:#e4f3ec;border-radius:20px;padding:5px 9px;font-size:.8rem}dl{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:12px 0}dt{color:#54707d}dd{text-align:right;margin:0;overflow-wrap:anywhere}dialog{border:1px solid #b4c9d0;border-radius:16px;max-width:460px;width:calc(100% - 32px);padding:24px}dialog::backdrop{background:#17323e88}nav{display:flex;gap:10px}nav button{width:auto}details{margin-top:15px}summary{cursor:pointer;font-weight:650}[hidden]{display:none!important}@media(max-width:600px){.grid{grid-template-columns:1fr}body{padding:12px}section,article{padding:16px}nav{flex-wrap:wrap}}\n</style></head><body><header><span class=\"tag\">SANTÉ • SITES 42 ET 38 • TEST PARTAGÉ V3.3</span><h1>Stock 42 — Santé</h1><p class=\"muted\">Le même inventaire sur PC et iPhone.</p></header>\n<section id=\"login\"><h2>Ouvrir l’inventaire partagé</h2><label for=\"token\">Clé privée Santé</label><input id=\"token\" name=\"password\" type=\"password\" autocomplete=\"current-password\" autocapitalize=\"off\" spellcheck=\"false\"><label class=\"remember\"><input id=\"remember\" type=\"checkbox\" checked>Rester connecté sur cet appareil personnel</label><button id=\"connect\">Se connecter</button><small>Connexion mémorisée pendant six mois si le navigateur le permet. « Se déconnecter » l’efface de cet appareil. Le stock alimentaire reste indépendant.</small></section>\n<p id=\"status\" role=\"status\" aria-live=\"polite\">Saisis la clé Santé pour consulter le stock.</p>\n<button id=\"retryConnection\" class=\"secondary\" hidden>Réessayer la connexion</button><div id=\"workspace\" hidden><p id=\"connectionState\" class=\"muted\"></p><nav><button id=\"refresh\">Actualiser</button><button id=\"download\" class=\"secondary\">Exporter une sauvegarde</button><button id=\"logout\" class=\"secondary\">Se déconnecter</button></nav><p id=\"updated\" class=\"muted\"></p><section><h2>Inventaire partagé</h2><div id=\"total\" class=\"quantity\"></div><p class=\"muted\">Sorties proposées par péremption, au sein de chaque taille. Les lots épuisés restent dans le journal.</p><div id=\"lots\"></div></section>\n<section><details id=\"receipt\"><summary>Enregistrer une réception de gants</summary><div class=\"grid\"><div><label for=\"size\">Taille</label><select id=\"size\"><option value=\"L\">L — robemed+ Ultra Sensitive</option><option value=\"M\">M — robemedical+ Ultra Protect</option></select></div><div><label for=\"boxes\">Boîtes de 100 gants</label><input id=\"boxes\" type=\"number\" min=\"1\" max=\"10000\" step=\"1\" value=\"1\"></div><div><label for=\"expiry\">Péremption</label><input id=\"expiry\" type=\"date\"></div><div><label for=\"manufacturer\">Lot fabricant (facultatif)</label><input id=\"manufacturer\" maxlength=\"80\"></div><div><label for=\"location\">Emplacement</label><select id=\"location\" aria-label=\"Emplacement de la réception\"><option value=\"À ranger\">À ranger</option></select></div><div><label for=\"barcode\">Code-barres (facultatif)</label><input id=\"barcode\" maxlength=\"80\"></div></div><button id=\"entry\">Confirmer la réception</button></details></section>\n<section><h2>Mouvements récents</h2><p class=\"muted\">Une annulation conserve la sortie d’origine. La sortie du premier test a été reconstituée ; son heure exacte est inconnue.</p><div id=\"events\"></div></section><p class=\"muted\">Version de test : gants L et M uniquement. Masques et sauvegardes automatiques à venir.</p></div>\n<dialog id=\"locationDialog\" aria-labelledby=\"locationTitle\"><h2 id=\"locationTitle\">Ranger / déplacer</h2><p id=\"locationLot\"></p><label for=\"assignLocation\">Emplacement existant</label><select id=\"assignLocation\"></select><p class=\"muted\">Ces codes sont ceux déjà utilisés au 42 et au 38. La liste ne précise pas la place disponible.</p><label for=\"assignPhoto\">Lire un QR existant depuis une photo</label><input id=\"assignPhoto\" type=\"file\" accept=\"image/*\"><p id=\"qrStatus\" role=\"status\">Choisis un emplacement ou photographie son QR.</p><button id=\"assignConfirm\">Confirmer le rangement</button><button id=\"assignCancel\" class=\"secondary\">Annuler</button><small>La lecture de la photo ne change pas le stock. Le rangement doit être confirmé.</small></dialog>\n<!--QR_DECODER-->\n<dialog id=\"confirmDialog\" aria-labelledby=\"confirmTitle\"><h2 id=\"confirmTitle\">Confirmer l’opération</h2><p id=\"confirmText\"></p><button id=\"confirmYes\">Confirmer</button><button id=\"confirmNo\" class=\"secondary\">Annuler</button></dialog>\n<script>\n'use strict';const $=id=>document.getElementById(id);let token='',state=null,busy=false,online=false,pending=null,rememberAfterLogin=false;\nconst CONNECTION_KEY='stock42_sante_remember_v1',CONNECTION_AGE=180*24*60*60*1000;\nconst uid=()=>Array.from(crypto.getRandomValues(new Uint8Array(16)),x=>x.toString(16).padStart(2,'0')).join('');\nfunction confirmAction(message){return new Promise(resolve=>{const d=$('confirmDialog');$('confirmText').textContent=message;const done=value=>{d.close();resolve(value);};$('confirmYes').onclick=()=>done(true);$('confirmNo').onclick=()=>done(false);d.oncancel=e=>{e.preventDefault();done(false);};d.showModal();});}\nfunction status(text,error=false){$('status').textContent=text;$('status').className=error?'error':'';}\nfunction controls(){document.querySelectorAll('button').forEach(b=>b.disabled=(b.id==='assignConfirm'&&qrReading)||b.dataset.blocked==='true'||busy||(!online&&!['connect','refresh','download','logout','retryConnection'].includes(b.id)));}\nfunction rpc(name,args){return new Promise((resolve,reject)=>google.script.run.withSuccessHandler(resolve).withFailureHandler(reject)[name](...args));}\nfunction show(result){if(!result||!result.ok||!Array.isArray(result.lots))throw Error('Réponse invalide.');state=result;online=true;$('login').hidden=true;$('workspace').hidden=false;render();status('Inventaire confirmé dans Google Sheets.');}\nasync function refresh(silent=false){if(busy||!token)return;busy=true;controls();if(!silent)status('Lecture de l’inventaire partagé…');try{show(await rpc('santeLire',[token]));$('retryConnection').hidden=true;if(rememberAfterLogin)rememberConnection();}catch(e){online=false;const message=e.message||'Connexion indisponible. Actualise avant toute opération.';if(message.includes('Clé Santé incorrecte')){forgetConnection();token='';rememberAfterLogin=false;state=null;$('workspace').hidden=true;$('login').hidden=false;$('retryConnection').hidden=true;status('La clé enregistrée n’est plus valide. Saisis la clé Santé actuelle.',true);}else{$('retryConnection').hidden=!token;status(message,true);}}finally{busy=false;controls();}}\nasync function act(command){if(busy||!online||!state)return;busy=true;online=false;controls();command={...command,uid:uid(),revision:state.revision};pending=command;status('Enregistrement et vérification…');try{show(await rpc('santeAgir',[token,command]));pending=null;}catch(e){status((e.message||'Confirmation indisponible.')+' Actualise pour vérifier le stock avant de recommencer.',true);}finally{busy=false;controls();}}\n$('connect').onclick=()=>{token=$('token').value.trim();$('token').value='';if(!token){status('Clé Santé requise.',true);return;}rememberAfterLogin=true;refresh();};$('retryConnection').onclick=()=>refresh();$('token').onkeydown=e=>{if(e.key==='Enter')$('connect').click();};$('refresh').onclick=()=>refresh();\n$('logout').onclick=()=>{forgetConnection();token='';state=null;pending=null;online=false;rememberAfterLogin=false;$('retryConnection').hidden=true;$('connectionState').textContent='';$('workspace').hidden=true;$('login').hidden=false;$('lots').replaceChildren();$('events').replaceChildren();status('Déconnecté.');};\n$('download').onclick=()=>{if(!state)return;const blob=new Blob([JSON.stringify({...state,exportedAt:new Date().toISOString()},null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='stock42-sante-'+new Date().toISOString().replace(/[:.]/g,'-')+'.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),2000);};\n$('entry').onclick=async()=>{const n=Number($('boxes').value);if(!Number.isSafeInteger(n)||n<1||n>10000||!$('expiry').value){status('Renseigne un nombre entier de boîtes et la péremption.',true);return;}if(await confirmAction('Enregistrer '+n+' boîte(s) de taille '+$('size').value+' dans le stock partagé ?'))act({action:'entree',size:$('size').value,quantity:n*100,expiry:$('expiry').value,manufacturer:$('manufacturer').value.trim(),location:$('location').value.trim()||'À ranger',barcode:$('barcode').value.trim()});};\nfunction text(parent,tag,value,cls=''){const e=document.createElement(tag);e.textContent=value;if(cls)e.className=cls;parent.appendChild(e);return e;}\nfunction render(){\n $('total').textContent=state.lots.reduce((n,l)=>n+l.quantity,0)+' gants';$('updated').textContent='Dernière lecture : '+new Date().toLocaleString('fr-FR')+' · actualisation automatique toutes les 30 secondes';$('lots').replaceChildren();$('events').replaceChildren();populateLocationSelect($('location'),$('location').value);\n const today=new Intl.DateTimeFormat('en-CA',{timeZone:'Europe/Paris',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());\n const sorted=state.lots.slice().sort((a,b)=>a.size.localeCompare(b.size)||a.expiry.localeCompare(b.expiry)||a.id.localeCompare(b.id));const first={};sorted.filter(l=>l.quantity>0&&l.expiry>=today).forEach(l=>{if(!first[l.size])first[l.size]=l.id;});\n sorted.filter(l=>l.quantity>0).forEach(l=>{const expired=l.expiry&&l.expiry<today,a=text($('lots'),'article','',''+(expired?'expired':''));text(a,'h3',l.id+' · Taille '+l.size);text(a,'p',l.name,'muted');text(a,'div',l.quantity+' gants','quantity');if(first[l.size]===l.id)text(a,'p','À utiliser en premier pour cette taille','pill');if(expired)text(a,'p','Périmé — sortie bloquée');const dl=document.createElement('dl');a.appendChild(dl);for(const [k,v]of [['Site',l.site],['Lot fabricant',l.manufacturer||'Non renseigné'],['Péremption',l.expiry.split('-').reverse().join('/')],['Emplacement',l.location],['Conditionnement','Boîte de 100']]){text(dl,'dt',k);text(dl,'dd',v);}const rangement=text(a,'button','Ranger / déplacer','secondary');rangement.onclick=()=>openLocation(l);const q=document.createElement('input');q.type='number';q.min='1';q.step='1';q.max=String(l.quantity);q.value=String(Math.min(100,l.quantity));q.setAttribute('aria-label','Quantité de gants à sortir de '+l.id);a.appendChild(q);const b=text(a,'button','Sortir des gants');b.disabled=expired;b.dataset.blocked=expired?'true':'false';b.onclick=async()=>{const n=Number(q.value);if